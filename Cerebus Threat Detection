// Opening splash: a rotating radar sweep with flashing "contacts".
static void splashRadar(){
  const int cx=64, cy=36, R=25;
  const float TWO_PI_F = 6.28318f;
  struct { float ang; int rad; } blip[] = {
    {0.6f,18},{2.1f,23},{3.6f,12},{5.0f,21},{4.2f,8} };
  const int nb = 5;
  for(int frame=0; frame<120; frame++){
    float sweep = frame * 0.16f;
    u8g2.clearBuffer();
    // rings + crosshair
    u8g2.drawCircle(cx,cy,R, U8G2_DRAW_ALL);
    u8g2.drawCircle(cx,cy,(R*2)/3, U8G2_DRAW_ALL);
    u8g2.drawCircle(cx,cy,R/3, U8G2_DRAW_ALL);
    u8g2.drawHLine(cx-R,cy,2*R);
    u8g2.drawVLine(cx,cy-R,2*R);
    // sweep beam + short trailing line
    u8g2.drawLine(cx,cy, cx+(int)(R*cosf(sweep)),        cy+(int)(R*sinf(sweep)));
    u8g2.drawLine(cx,cy, cx+(int)(R*cosf(sweep-0.30f)),  cy+(int)(R*sinf(sweep-0.30f)));
    // contacts light up as the beam passes
    for(int i=0;i<nb;i++){
      float d = fmodf(sweep - blip[i].ang, TWO_PI_F); if(d<0) d+=TWO_PI_F;
      if(d < 0.7f){
        int bx=cx+(int)(blip[i].rad*cosf(blip[i].ang));
        int by=cy+(int)(blip[i].rad*sinf(blip[i].ang));
        u8g2.drawDisc(bx,by, d<0.25f?3:2, U8G2_DRAW_ALL);
      }
    }
    // title
    u8g2.setFont(u8g2_font_6x10_tf);
    u8g2.drawStr(40,8,"CERBERUS");
    u8g2.sendBuffer();
    delay(16);
  }
}

// ----------------------------------------------------------------------------
// Pages / button
// ----------------------------------------------------------------------------
static void enterPage(int p){
  gPage=p; bool wantBt=(p==P_BLE_SPAM);
#if ENABLE_BT
  if(wantBt && !gRadioIsBt){ bleStart(); gRadioIsBt=true; gBtAdv=0; }
  if(!wantBt && gRadioIsBt){ bleStop(); wifiPromis(true); gRadioIsBt=false; }
#else
  (void)wantBt;
#endif
  renderPage();
}
static void handleButton(){
  static bool prev=HIGH; static uint32_t last=0; bool now=digitalRead(kButtonPin);
  if(prev==HIGH && now==LOW && millis()-last>250){ last=millis(); enterPage((gPage+1)%P_COUNT); }
  prev=now;
}
static void announceIfPending(){
  if(!gAlertPending) return; gAlertPending=false; gAlertTotal++;
  Alert a=gLastAlert;
  Serial.printf("[ALERT] %s | %s\n", a.kind, a.info);
#if ENABLE_LORA
  loraSendAlert(a.kind, a.info);
#endif
  flashLed(); renderAlert(); gAlertScreenUntil=millis()+kAlertScreenMs;
}

// ----------------------------------------------------------------------------
// Setup / loop
// ----------------------------------------------------------------------------
void setup(){
  Serial.begin(115200); delay(300);
  Serial.println(F("\nCERBERUS : three-band receive-only wireless threat monitor"));
  pinMode(kButtonPin, INPUT_PULLUP);
  if(kAlertLedPin>=0){ pinMode(kAlertLedPin,OUTPUT); digitalWrite(kAlertLedPin,LOW); }
  memset(gStats,0,sizeof(gStats));
  oledInit();
  splashRadar();                              // animated opening sweep
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_7x14B_tf); u8g2.drawStr(36,22,"CERBERUS");
  u8g2.setFont(u8g2_font_6x10_tf);  u8g2.drawStr(4,40,"WiFi  BLE  SubGHz");
  u8g2.drawStr(4,54,"PRG=cycle  RX-only"); u8g2.sendBuffer(); delay(1100);
  radioStart();
#if ENABLE_LORA
  loraInit();
#endif
  gRateTick=esp_timer_get_time();
  enterPage(P_DEAUTH);
}

void loop(){
  handleButton();

#if ENABLE_BT
  if(gPage==P_BLE_SPAM){
    gBtAdv=0; if(gBleScan){ gBleScan->start(1,false); gBleScan->clearResults(); }
    if(gBtAdv>=BLE_ADV_ALERT){ char info[88]; snprintf(info,sizeof(info),"%d adv/s",gBtAdv); raiseAlert("BLE SPAM",info,0); }
    announceIfPending();
    if(millis()>=gAlertScreenUntil) renderPage();
    return;
  }
#endif

#if ENABLE_LORA
  if(gPage==P_SUBGHZ_BRUTE && gLoraOk){
    // Fast-sample RSSI for ~1s and count rising edges above the floor. A
    // brute-force cycles many short bursts; a single fob press is only a few.
    if(gSubNoise < -200.0f) gSubNoise = subghzRssi();
    int bursts=0; bool above=false; float peak=-200.0f;
    uint32_t until=millis()+1000;
    while((int32_t)(until-millis())>0){
      float r=lora.getRSSI(false);
      if(r>peak) peak=r;
      bool hi = r > gSubNoise + SUBGHZ_BURST_MARGIN;
      if(hi && !above){ bursts++; above=true; }
      else if(!hi){ above=false; gSubNoise = 0.995f*gSubNoise + 0.005f*r; }
      delayMicroseconds(800);
    }
    gSubBursts=bursts; gSubRssi=peak;
    if(bursts>=SUBGHZ_BURST_RATE && millis()-gSubBruteAlertMs>5000){
      gSubBruteAlertMs=millis();
      char info[88]; snprintf(info,sizeof(info),"%d bursts/s peak%d dBm @%.0fMHz",bursts,(int)peak,LORA_FREQ);
      raiseAlert("SUBGHZ BRUTE", info, 0);
    }
    announceIfPending();
    if(millis()>=gAlertScreenUntil) renderPage();
    return;
  }
  if(gPage==P_SUBGHZ_JAM && gLoraOk){
    float r=subghzRssi();
    gSubRssi=r;
    if(gSubNoise < -200.0f) gSubNoise=r;        // first sample seeds the floor
    bool high = (r > gSubNoise + SUBGHZ_JAM_MARGIN) && (r > SUBGHZ_ABS_FLOOR);
    if(high){
      gSubHigh++;
    } else {
      gSubHigh=0;
      gSubNoise = 0.95f*gSubNoise + 0.05f*r;     // learn the floor only when quiet
    }
    if(gSubHigh>=SUBGHZ_SUSTAIN && millis()-gSubAlertMs>5000){
      gSubAlertMs=millis();
      char info[88]; snprintf(info,sizeof(info),"RSSI %d dBm (floor %d) @%.0fMHz",(int)r,(int)gSubNoise,LORA_FREQ);
      raiseAlert("SUBGHZ JAM", info, 0);
    }
  }
#endif

  // WiFi pages: sweep channels.
  gCurrentChannel=(gCurrentChannel>=MAX_CHANNEL)?1:gCurrentChannel+1;
  esp_wifi_set_channel(gCurrentChannel,WIFI_SECOND_CHAN_NONE);
  delay(CHANNEL_DWELL_MS);

  int64_t now=esp_timer_get_time();
  if(now-gRateTick>=1000000){ gRateTick=now;
    gPktRate=gAllPkts-gBasePkts; gBasePkts=gAllPkts;
    gDeauthRate=gDeauthTotal-gBaseDeauth; gBaseDeauth=gDeauthTotal;
    gBruteRate=gBruteTotal-gBaseBrute; gBaseBrute=gBruteTotal;
    if(gPage==P_WIFI_JAM && gPktRate>=JAM_RATE){ char info[88]; snprintf(info,sizeof(info),"%lu frames/s ch%d",(unsigned long)gPktRate,gCurrentChannel); raiseAlert("RF FLOOD/JAM",info,gCurrentChannel); }
    if(gPage==P_DEAUTH && gDeauthRate>=DEAUTH_RATE_ALERT){ char info[88]; snprintf(info,sizeof(info),"%lu deauth/s (hopping)",(unsigned long)gDeauthRate); raiseAlert("DEAUTH FLOOD",info,gCurrentChannel); }
    if(gPage==P_WIFI_BRUTE && gBruteRate>=BRUTE_RATE_ALERT){ char info[88]; snprintf(info,sizeof(info),"%lu auth/s (hopping)",(unsigned long)gBruteRate); raiseAlert("WIFI BRUTE",info,gCurrentChannel); }
  }

  announceIfPending();
  if(millis()>=gAlertScreenUntil) renderPage();
}
