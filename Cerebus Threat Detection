}
// Instantaneous channel RSSI (dBm). getRSSI(false) reads the live RSSI register
// while in RX; getRSSI() (default) would return the LAST PACKET's RSSI, which is
// stale/garbage when no packet arrives -> that caused the constant false alarm.
static float subghzRssi(){ return gLoraOk ? lora.getRSSI(false) : -127.0f; }
