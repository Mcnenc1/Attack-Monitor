static void loraSendAlert(const char* kind, const char* info){
  if(!gLoraOk) return;
  char msg[120]; snprintf(msg,sizeof(msg),"ALERT %s | %s", kind, info);
  lora.transmit((uint8_t*)msg, strlen(msg));
