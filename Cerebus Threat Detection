// ----------------------------------------------------------------------------
// WiFi promiscuous capture (receive-only). Detection runs here (light math);
// alerts are only stashed, never printed from here.
// ----------------------------------------------------------------------------
static void parseMgmtSsid(const uint8_t* p, int len, int ch, const uint8_t* bssid){
  if(len<38) return;
  uint16_t cap = p[34] | (p[35]<<8);
  bool isOpen = (cap & 0x0010)==0;
  int pos=36; char ssid[33]={0};
  while(pos+2<=len){ uint8_t t=p[pos], l=p[pos+1]; if(pos+2+l>len) break;
    if(t==0){ int n=l>32?32:l; memcpy(ssid,p+pos+2,n); ssid[n]='\0'; break; } pos+=2+l; }
  if(!ssid[0]) return;
  static int64_t lastPortal=0; int64_t now=esp_timer_get_time();
  if(isOpen && isBait(ssid) && now-lastPortal>COOLDOWN_US){
    lastPortal=now; gBaitHits++;
    char info[88]; snprintf(info,sizeof(info),"OPEN \"%s\" ch%d",ssid,ch);
    raiseAlert("ROGUE PORTAL", info, ch); return; }
  if(isProtected(ssid) && !isAllowed(bssid) && now-lastPortal>COOLDOWN_US){
    lastPortal=now; gEvilTwin++;
    char info[88]; snprintf(info,sizeof(info),"\"%s\" unknown BSSID ch%d",ssid,ch);
    raiseAlert("EVIL TWIN", info, ch); }
}

static void rxCb(void* buf, wifi_promiscuous_pkt_type_t type){
  if(type!=WIFI_PKT_MGMT) return;
  const wifi_promiscuous_pkt_t* pkt=(const wifi_promiscuous_pkt_t*)buf;
  const uint8_t* p=pkt->payload; int len=pkt->rx_ctrl.sig_len;
  if(len<24) return;
  gAllPkts++;
  uint8_t ftype=(p[0]>>2)&0x03, fsub=(p[0]>>4)&0x0F;
  if(ftype!=0) return;
  int ch=pkt->rx_ctrl.channel; int8_t rssi=pkt->rx_ctrl.rssi;
  const uint8_t* dst=p+4; const uint8_t* bssid=p+16;
  int64_t now=esp_timer_get_time();

  if(fsub==0x0C || fsub==0x0A){                 // deauth / disassoc
    gDeauthTotal++;
    bool bcast=true; for(int i=0;i<6;i++) if(dst[i]!=0xFF){bcast=false;break;}
    stat_t* s=slotFor(bssid,now); s->lastSeen=now; s->rssi=rssi; s->ch=ch;
    if(now-s->dWin>1000000){ s->dEwma=(1-EWMA_ALPHA)*s->dEwma+EWMA_ALPHA*s->dCount; s->dCount=0; s->dBcast=0; s->dWin=now; }
    s->dCount++; if(bcast) s->dBcast++;
    bool flood=(s->dCount>=DEAUTH_ABS)&&((float)s->dCount>=s->dEwma+BASELINE_MARGIN);
    bool b=(s->dBcast>=DEAUTH_BCAST);
    if((flood||b)&&now-s->dAlert>COOLDOWN_US){ s->dAlert=now;
      char info[88]; snprintf(info,sizeof(info),"%02X%02X%02X %u/s b%u ch%d %ddBm",
        s->bssid[3],s->bssid[4],s->bssid[5],(unsigned)s->dCount,(unsigned)s->dBcast,ch,rssi);
      raiseAlert(b?"DEAUTH BCAST":"DEAUTH FLOOD", info, ch); }
  } else if(fsub==0x0B || fsub==0x00 || fsub==0x02){  // auth / assoc / reassoc req
    gBruteTotal++;
    stat_t* s=slotFor(bssid,now); s->lastSeen=now; s->rssi=rssi; s->ch=ch;
    if(now-s->bWin>1000000){ s->bCount=0; s->bWin=now; }
    s->bCount++;
    if(s->bCount>=BRUTE_ABS && now-s->bAlert>COOLDOWN_US){ s->bAlert=now;
      char info[88]; snprintf(info,sizeof(info),"%02X%02X%02X %u auth/s ch%d",
        s->bssid[3],s->bssid[4],s->bssid[5],(unsigned)s->bCount,ch);
      raiseAlert("WIFI BRUTE", info, ch); }
  } else if(fsub==0x08 || fsub==0x05){           // beacon / probe-resp
    if(gPage==P_EVIL_PORTAL) parseMgmtSsid(p,len,ch,bssid);
  }
}

static void radioStart(){
  nvs_flash_init(); esp_netif_init(); esp_event_loop_create_default();
  wifi_init_config_t cfg=WIFI_INIT_CONFIG_DEFAULT(); esp_wifi_init(&cfg);
  esp_wifi_set_storage(WIFI_STORAGE_RAM); esp_wifi_set_mode(WIFI_MODE_NULL); esp_wifi_start();
  wifi_promiscuous_filter_t f={}; f.filter_mask=WIFI_PROMIS_FILTER_MASK_MGMT;
  esp_wifi_set_promiscuous_filter(&f); esp_wifi_set_promiscuous_rx_cb(&rxCb);
  esp_wifi_set_promiscuous(true); esp_wifi_set_channel(1,WIFI_SECOND_CHAN_NONE);
}
static void wifiPromis(bool on){ esp_wifi_set_promiscuous(on); }

