// Detection thresholds (per 1 s window unless noted).
const uint32_t DEAUTH_ABS      = 20;   // deauth/window/BSSID (per-BSSID path)
const uint32_t DEAUTH_BCAST    = 5;    // broadcast deauth/window/BSSID
const uint32_t DEAUTH_RATE_ALERT = 8;  // total deauth/s (robust to channel hopping)
const float    BASELINE_MARGIN = 8.0f;
const float    EWMA_ALPHA      = 0.2f;
const uint32_t BRUTE_ABS       = 25;   // auth+assoc/window/BSSID (per-BSSID path)
const uint32_t BRUTE_RATE_ALERT = 10;  // total auth+assoc/s (robust to hopping)
const uint32_t JAM_RATE        = 1200; // all frames/s -> RF flood / jam
const int      BLE_ADV_ALERT   = 80;   // BLE advs per 1 s scan
const float    SUBGHZ_JAM_MARGIN = 18.0; // dB above the learned noise floor -> jam
const int      SUBGHZ_ABS_FLOOR  = -75;  // and must be at least this strong (dBm)
const int      SUBGHZ_SUSTAIN    = 5;    // consecutive high samples before alerting
const float    SUBGHZ_BURST_MARGIN = 12.0; // dB above floor that counts as one RF burst
const int      SUBGHZ_BURST_RATE   = 15;   // bursts/s -> possible brute force
const int64_t  COOLDOWN_US      = 5000000; // 5 s per-source alert cooldown
const int      MAX_TRACKED      = 48;

const uint32_t CHANNEL_DWELL_MS = 150;
const int      MAX_CHANNEL       = 13;

