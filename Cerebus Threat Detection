// ----------------------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------------------
static bool macEq(const uint8_t* a, const uint8_t* b){ return memcmp(a,b,6)==0; }
static bool isProtected(const char* s){ for(int i=0;i<kProtectedSsidCount;i++) if(!strcmp(s,kProtectedSsids[i])) return true; return false; }
static bool isBait(const char* s){ for(int i=0;i<kBaitSsidCount;i++) if(!strcasecmp(s,kBaitSsids[i])) return true; return false; }
static bool isAllowed(const uint8_t* m){ for(int i=0;i<kAllowedBssidCount;i++) if(macEq(m,kAllowedBssids[i])) return true; return false; }

static stat_t* slotFor(const uint8_t* b, int64_t now){
  stat_t* lru=&gStats[0];
  for(int i=0;i<MAX_TRACKED;i++){ stat_t* s=&gStats[i];
    if(s->used && macEq(s->bssid,b)) return s;
    if(!s->used){ memset(s,0,sizeof(*s)); s->used=true; memcpy(s->bssid,b,6); s->dWin=s->bWin=now; return s; }
    if(s->lastSeen<lru->lastSeen) lru=s; }
  memset(lru,0,sizeof(*lru)); lru->used=true; memcpy(lru->bssid,b,6); lru->dWin=lru->bWin=now; return lru;
}

// Stash an alert. SAFE to call from the WiFi callback (no blocking work here).
static void raiseAlert(const char* kind, const char* info, int channel){
  strncpy(gLastAlert.kind, kind, sizeof(gLastAlert.kind)-1); gLastAlert.kind[sizeof(gLastAlert.kind)-1]='\0';
  strncpy(gLastAlert.info, info?info:"", sizeof(gLastAlert.info)-1); gLastAlert.info[sizeof(gLastAlert.info)-1]='\0';
  gLastAlert.channel = channel; gAlertPending = true;
}

static void flashLed(){ if(kAlertLedPin<0) return; for(int i=0;i<4;i++){ digitalWrite(kAlertLedPin,HIGH); delay(40); digitalWrite(kAlertLedPin,LOW); delay(40);} }

