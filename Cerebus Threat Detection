// Per-BSSID stats for deauth + brute detection.
typedef struct {
  bool used; uint8_t bssid[6];
  int64_t dWin; uint32_t dCount, dBcast; float dEwma; int64_t dAlert;
  int64_t bWin; uint32_t bCount; int64_t bAlert;
  int64_t lastSeen; int8_t rssi; uint8_t ch;
} stat_t;
static stat_t gStats[MAX_TRACKED];

// Alert stash (callback-safe: no Serial/LED/radio here; loop announces).
struct Alert { char kind[28]; char info[88]; int channel; };
